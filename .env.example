# 이 파일을 .env로 복사해 값을 채우세요. (.env는 GitHub에 올라가지 않습니다)
# 아래는 모두 서버에서만 쓰는 값입니다. 변수 이름 앞에 NEXT_PUBLIC_을 붙이지 마세요.

# OpenAI: 우선순위 이유 문구 작성 (없으면 코드가 만든 기본 문구를 씀)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Supabase: 이월 보관함·주간 리포트 저장소 (없으면 두 기능만 꺼짐)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 이름·사번·PIN을 변환(해시)하는 비밀 키. 임의의 긴 문자열. 한 번 정하면 바꾸지 마세요(바꾸면 기존 기록을 못 찾습니다).
OWNER_HASH_SECRET=
